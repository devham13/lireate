<?xml version="1.0"?>
<ruleset name="LIREATE PHP 5.6 deploy paths">
    <config name="testVersion" value="5.6"/>
    <rule ref="PHPCompatibility"/>
    <file>pages/blog/_shared</file>
    <file>template/page/news</file>
    <file>pages/services/_shared</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
