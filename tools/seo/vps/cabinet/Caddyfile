{
  auto_https off
}

:80 {
  encode gzip
  respond /healthz 200
  handle_path /reports/* {
    root * /srv/reports
    file_server browse
  }
  handle_path /siteone/* {
    root * /srv/siteone
    file_server browse
  }
  handle_path /indexlift/* {
    root * /srv/indexlift
    file_server browse
  }
  handle /seonaut/* {
    uri strip_prefix /seonaut
    reverse_proxy seonaut:9000
  }
  @protected not path /healthz
  basic_auth @protected {
    import /etc/caddy/htpasswd
  }
  handle {
    root * /srv/www
    file_server
  }
}