# Nero Network Office Page 0.2
# Copy this file to .env or add the same names to Cursor Cloud Secrets / Environment Variables.
# Never commit real values.

# Cursor / automation
CURSOR_API_KEY=
WORKER_POOL_NAME=nero-network-office

# Public site (REG.RU: lireate.ru)
SITE_BRAND=
SITE_NICHE=
WP_SITE_URL=https://lireate.ru
WP_ADMIN_URL=
PUBLIC_SITE_URL=https://lireate.ru
PUBLIC_SITE_HOST=lireate.ru
WP_THEME_SLUG=
WP_CLI_BIN=wp
PHP_BIN=

# WordPress paths (корень сайта — «Домашняя директория» в ISPmanager REG.RU, часто .../www/lireate.ru)
REMOTE_SITE_ROOT=
REMOTE_WP_CONTENT=wp-content
REMOTE_WP_THEMES=wp-content/themes
REMOTE_WP_PLUGINS=wp-content/plugins
SSH_THEME_PATH=wp-content/themes

# SSH / SFTP / FTP (хост = lireate.ru, логин/пароль из панели REG.RU → SSH/SFTP)
SSH_HOST=lireate.ru
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SFTP_HOST=lireate.ru
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
FTP_HOST=lireate.ru
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=

# CTA / advertising, optional
TELEGRAM_CHANNEL_URL=
PRIMARY_CTA_LABEL=
PRIMARY_CTA_URL=
SECONDARY_CTA_LABEL=
SECONDARY_CTA_URL=
AD_BANNER_URL=
AD_BANNER_IMAGE_URL=
AD_BANNER_ALT=

# Optional notes
PANEL_URL=https://www.reg.ru/user/account/
NOTES=Hosting: REG.RU (lireate.ru). Do not use Beget or meta-journal.ru credentials.

# Google Sheets (topics table)
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_TAB=
GOOGLE_SHEET_NAME=Лист1
GOOGLE_SHEETS_LINK_COLUMN=
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=
# legacy: service-account fallback (optional)
GOOGLE_SERVICE_ACCOUNT_BASE64=
GOOGLE_SHEETS_DEFAULT_SHEET=

# IndexNow (post-publish notify)
INDEXNOW_KEY=
INDEXNOW_HOST=
