# LIREATE Office — copy to .env or Cursor Cloud Secrets
# Never commit real values.

SITE_BRAND=LIREATE
SITE_NICHE=юридические услуги, ИС, товарные знаки, патенты, арбитраж
PUBLIC_SITE_URL=
PUBLIC_SITE_HOST=lireate.ru

# CTA (контакты / форма на сайте)
PRIMARY_CTA_LABEL=Получить консультацию
PRIMARY_CTA_URL=
SECONDARY_CTA_LABEL=
SECONDARY_CTA_URL=

# Опционально: рекламный баннер (для LIREATE обычно пусто)
AD_BANNER_URL=
AD_BANNER_IMAGE_URL=
AD_BANNER_ALT=

# IndexNow (после live-публикации на хостинге)
INDEXNOW_KEY=
INDEXNOW_HOST=lireate.ru

# --- Только на хостинге REG.RU ($HOME/lireate-autopub/.env) ---
# LIREATE_DOCROOT=/var/www/u3650956/data/www/public_html
# LIREATE_PUBLIC_SITE_URL=
# LIREATE_OFFICE_REPO=$HOME/lireate-autopub/office-repo
# LIREATE_ALLOW_PUBLISH=no
# LIREATE_SERVICE_SLUG=

# Устарело для Cloud-пайплайна услуг (не заполнять):
# WP_*, FTP_*, SSH_*, GOOGLE_SHEET_*, VK_*
